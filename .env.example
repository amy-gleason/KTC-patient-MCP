# Public base URL of this MCP server (no trailing slash).
# Used to construct SMART Health Link manifest URLs.
PUBLIC_BASE_URL=https://localhost:8443

# HTTPS bind host/port
HOST=0.0.0.0
PORT=8443

# TLS cert/key paths. If omitted, server falls back to plain HTTP (dev only).
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key

# 32-byte hex key used to encrypt stored payloads at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_ENCRYPTION_KEY=

# Default link lifetime in seconds (1 hour default, max 30 days).
DEFAULT_LINK_TTL_SECONDS=3600
MAX_LINK_TTL_SECONDS=2592000

# Audit log destination: "stdout" or a file path.
AUDIT_LOG=stdout
